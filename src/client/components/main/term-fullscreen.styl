.fullscreen
  .sidebar
  .tabs
  .terminal-footer
  .terminal-control
  .qm-wrap-tooltip
  .main-footer
  .session-v-info
    display none
  // Mobile tabs carry the extra .mobile-tabs class, and mobile.styl uses
  // .is-mobile .tabs.mobile-tabs (specificity 0,3,0) which overrides the
  // .fullscreen .tabs rule above (0,2,0). This ensures they stay hidden.
  .tabs.mobile-tabs
    display none
  // Hide all sessions first
  .session-wrap
    display none
  // Only show the session that matches the fullscreen tab ID
  .session-wrap.session-current
    display block !important
    position fixed
    left 0 !important
    top 0 !important
    height 100% !important
    width 100% !important
    .term-wrap
    .session-v-wrap
      position fixed
      left 0 !important
      top 0 !important
      height 100% !important
      width 100% !important
    .term-wrap-1
      left 10px !important
      top 10px !important
      right 10px !important
      bottom 10px !important

// while the touch shortcut bar (portaled to body, z-index 800 — see
// shortcut-bar.styl) is shown, shrink the fullscreen session by the bar
// height so the terminal is not covered. body.shortcut-bar-on is toggled by
// shortcut-bar.jsx; the extra body class gives this rule higher specificity
// (0,4,0) than the .fullscreen rules above, so it wins the !important battle.
body.shortcut-bar-on
  .fullscreen
    .session-wrap.session-current
      bottom var(--shortcut-bar-h, 44px) !important
      height auto !important
      .term-wrap
        height calc(100% - var(--shortcut-bar-h, 44px)) !important
